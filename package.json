{
    "name": "uniform-administration",
    "type": "module",
    "version": "2.6.2",
    "private": true,
    "engines": {
        "node": "^24"
    },
    "scripts": {
        "dev": "next dev -p 3021",
        "build": "next build",
        "build:test": "cross-env NEXT_PUBLIC_STAGE=TEST next build",
        "start": "next start -p 3021",
        "test:e2e": "playwright test",
        "test:vitest": "npm run test:dal && npm run test:components",
        "test:components": "vitest run --config vitest.frontend.config.ts",
        "test:dal": "npm run test:dal:unit && npm run test:dal:integration",
        "test:dal:unit": "vitest run --config vitest.dal-unit.config.ts",
        "test:dal:integration": "vitest run --config vitest.dal-integration.config.ts",
        "test:watch:components": "vitest --config vitest.frontend.config.ts",
        "test:watch:dal:unit": "vitest --config vitest.dal-unit.config.ts",
        "test:watch:dal:integration": "vitest --config vitest.dal-integration.config.ts --watch",
        "test:coverage:all": "npm run test:all -- --coverage",
        "test:coverage:components": "vitest run --config vitest.frontend.config.ts --coverage",
        "lint": "eslint src tests",
        "lint:fix": "eslint src tests --fix"
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "7.2.0",
        "@fortawesome/free-regular-svg-icons": "7.2.0",
        "@fortawesome/free-solid-svg-icons": "7.2.0",
        "@fortawesome/react-fontawesome": "3.3.0",
        "@hookform/resolvers": "5.2.2",
        "@prisma/adapter-pg": "7.5.0",
        "@prisma/client": "7.5.0",
        "@react-email/html": "0.0.12",
        "@react-email/render": "2.0.4",
        "@swc/core": "1.15.21",
        "@types/react-dnd": "3.0.2",
        "bcrypt": "6.0.0",
        "bootstrap": "5.3.8",
        "clsx": "2.1.1",
        "date-fns": "4.1.0",
        "dayjs": "1.11.20",
        "debounce": "2.2.0",
        "dotenv": "17.3.1",
        "exceljs": "4.4.0",
        "iron-session": "8.0.4",
        "jsonwebtoken": "9.0.3",
        "next": "15.5.14",
        "next-international": "1.3.1",
        "nodemailer": "7.0.13",
        "react": "19.2.4",
        "react-bootstrap": "2.10.10",
        "react-date-picker": "12.0.1",
        "react-dnd": "16.0.1",
        "react-dnd-html5-backend": "16.0.1",
        "react-dom": "19.2.4",
        "react-email": "5.2.10",
        "react-error-boundary": "6.1.1",
        "react-fontawesome": "1.7.1",
        "react-hook-form": "7.71.2",
        "react-toastify": "11.0.5",
        "react-tooltip": "5.30.0",
        "recharts": "^3.8.0",
        "sass": "1.98.0",
        "server-only": "0.0.1",
        "swr": "2.4.1",
        "timers": "0.1.1",
        "usehooks-ts": "3.1.1",
        "uuid": "^13.0.0",
        "uuidv4": "6.2.13",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@babel/core": "7.29.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/bcrypt": "6.0.0",
        "@types/jsdom": "28.0.1",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "24.12.0",
        "@types/nodemailer": "7.0.11",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "8.57.2",
        "@vitejs/plugin-react": "6.0.1",
        "@vitest/coverage-v8": "4.1.1",
        "@vitest/eslint-plugin": "^1.6.13",
        "cross-env": "10.1.0",
        "eslint": "9.39.4",
        "eslint-config-next": "15.5.14",
        "eslint-plugin-playwright": "2.10.1",
        "eslint-plugin-testing-library": "7.16.2",
        "jsdom": "28.1.0",
        "playwright": "1.58.2",
        "prisma": "7.5.0",
        "ts-node": "10.9.2",
        "tsx": "4.21.0",
        "typescript": "5.9.3",
        "vitest": "4.1.1"
    }
}
