{
    "name": "uniform-administration",
    "type": "module",
    "version": "2.7.3",
    "private": true,
    "engines": {
        "node": "^24"
    },
    "scripts": {
        "dev": "next dev -p 3021",
        "build": "next build",
        "build:test": "cross-env NEXT_PUBLIC_STAGE=TEST next build",
        "start": "next start -p 3021",
        "test:e2e": "playwright test",
        "test:vitest": "npm run test:dal && npm run test:components",
        "test:components": "vitest run --config vitest.frontend.config.ts",
        "test:dal": "npm run test:dal:unit && npm run test:dal:integration",
        "test:dal:unit": "vitest run --config vitest.dal-unit.config.ts",
        "test:dal:integration": "vitest run --config vitest.dal-integration.config.ts",
        "test:watch:components": "vitest --config vitest.frontend.config.ts",
        "test:watch:dal:unit": "vitest --config vitest.dal-unit.config.ts",
        "test:watch:dal:integration": "vitest --config vitest.dal-integration.config.ts --watch",
        "test:coverage:all": "npm run test:all -- --coverage",
        "test:coverage:components": "vitest run --config vitest.frontend.config.ts --coverage",
        "lint": "eslint src tests",
        "lint:fix": "eslint src tests --fix",
        "db:reset": "npx prisma generate; npx prisma migrate reset --force; npx prisma db seed"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-regular-svg-icons": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/react-fontawesome": "3.5.0",
        "@hookform/resolvers": "5.9.1",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "@react-email/html": "0.0.12",
        "@react-email/render": "2.1.0",
        "@swc/core": "1.16.2",
        "@types/react-dnd": "3.0.2",
        "babel-plugin-react-compiler": "1.0.0",
        "bcrypt": "6.0.0",
        "bootstrap": "5.3.8",
        "clsx": "2.1.1",
        "date-fns": "4.4.0",
        "dayjs": "1.11.23",
        "debounce": "3.0.0",
        "dotenv": "17.4.2",
        "exceljs": "4.4.0",
        "iron-session": "8.0.4",
        "jsonwebtoken": "9.0.3",
        "next": "^16.3.5",
        "next-international": "1.3.1",
        "nodemailer": "^9.1.1",
        "react": "19.3.0",
        "react-bootstrap": "2.10.10",
        "react-date-picker": "12.1.0",
        "react-dnd": "16.0.1",
        "react-dnd-html5-backend": "16.0.1",
        "react-dom": "19.3.0",
        "react-email": "6.9.5",
        "react-error-boundary": "6.1.5",
        "react-fontawesome": "1.7.1",
        "react-hook-form": "7.88.0",
        "react-toastify": "11.1.0",
        "react-tooltip": "6.0.8",
        "recharts": "3.10.1",
        "sass": "1.104.1",
        "server-only": "0.0.1",
        "swr": "2.5.1",
        "timers": "0.1.1",
        "usehooks-ts": "3.1.1",
        "uuid": "14.0.2",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@babel/core": "8.0.5",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/bcrypt": "6.0.0",
        "@types/jsdom": "30.0.0",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "24.13.4",
        "@types/nodemailer": "8.0.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/coverage-v8": "5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "cross-env": "10.1.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.5",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-testing-library": "^7.16.2",
        "jsdom": "30.0.1",
        "playwright": "1.63.0",
        "prisma": "7.10.0",
        "ts-node": "10.9.2",
        "tsx": "4.23.13",
        "typescript": "6.0.3",
        "vitest": "^5.0.0"
    },
    "allowScripts": {
        "@prisma/engines@*": true,
        "@parcel/watcher@*": true,
        "bcrypt@*": true,
        "prisma@*": true,
        "@swc/core@*": true,
        "esbuild@*": true
    },
    "overrides": {
        "exceljs": {
            "uuid": ">=14.0.1"
        },
        "prisma": {
            "deepmerge-ts": ">=8.0.2",
            "mysql2": ">=3.24.4"
        }
    }
}
